{
  "name": "@aigenos/flow",
  "version": "0.3.1",
  "description": "React renderer + headless hook for aigenos/flow — typed widgets for deterministic agent chats",
  "license": "Apache-2.0",
  "homepage": "https://aigenos.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aigenos/flow.git",
    "directory": "frontend"
  },
  "type": "module",
  "main": "./dist/lib/index.cjs",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "node": {
        "import": "./dist/lib/index.node.js",
        "require": "./dist/lib/index.cjs"
      },
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.cjs",
      "default": "./dist/lib/index.js"
    },
    "./style.css": "./dist/lib/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/lib/index.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts --mode bundler && vite build --config vite.lib.config.ts --mode node",
    "check:lib": "node src/tools/verify-lib-build.mjs && node src/tools/verify-primitives.mjs",
    "preview": "vite preview",
    "prepack": "npm run build:lib && npm run check:lib"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "marked": "^18.0.9",
    "monaco-editor": "^0.55.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "yaml": "^2.6.1"
  },
  "bugs": "https://github.com/aigenos/flow/issues",
  "keywords": [
    "aigenos",
    "flow",
    "react",
    "ag-ui",
    "a2ui",
    "mcp-ui",
    "generative-ui",
    "widgets",
    "chat",
    "agent"
  ]
}
