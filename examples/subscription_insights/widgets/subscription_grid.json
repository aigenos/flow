{
  "id": "subscription_grid",
  "version": "1.0.0",
  "description": "Single-select grid of a user's streaming subscriptions. Referenced from subscription-insights/SKILL.md — always renders the same way.",
  "bindings": ["rows"],
  "submit_schema": {
    "type": "object",
    "properties": {
      "subscription_id": { "type": "string" },
      "subscription_name": { "type": "string" }
    },
    "required": ["subscription_id"]
  },
  "spec": {
    "type": "card",
    "props": { "title": "Your subscriptions", "subtitle": "Select one to see its details" },
    "children": [
      {
        "type": "form",
        "props": { "submitLabel": "Show details" },
        "children": [
          {
            "type": "datatable",
            "props": {
              "rows": "{{rows}}",
              "columns": [
                { "key": "service", "label": "Service" },
                { "key": "plan", "label": "Plan" },
                { "key": "monthly_price", "label": "Monthly" },
                { "key": "status", "label": "Status" }
              ],
              "fields": {
                "subscription_id": "id",
                "subscription_name": "service"
              }
            }
          }
        ]
      }
    ]
  }
}
